# Application
APP_NAME="LinkHop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=UTC

# Super Admin Email (will have full access)
# Becomes the `owner` role on `php artisan hop:bootstrap`; kept as a fallback so the owner is never locked out.
SUPERADMIN_EMAIL=admin@yourdomain.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helink
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Session
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
# Minutes without activity before a signed-in session ends (the inactivity logout uses the same
# value). Shorter is safer on shared computers; longer means fewer "session expired" prompts.
# With "remember me" the user is signed back in silently, so this mostly limits idle tabs.
SESSION_LIFETIME=120
AUTH_REMEMBER_MINUTES=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (Optional - for better performance)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# GeoIP Service (for location tracking)
GEOIP_SERVICE=ipapi
IPAPI_KEY=your-ipapi-key

# Cloudflare Turnstile (Optional - CAPTCHA)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry (Optional - Error tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# AWS (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Proxies in front of the app (Cloudflare ranges, 127.0.0.1 for local nginx, or * if only reachable via proxy)
TRUSTED_PROXIES=cloudflare

# Abuse protection (optional)
SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
ABUSE_REGISTER_PER_HOUR=3
GUEST_LINK_IDLE_DAYS=14
GUEST_LINK_MAX_DAYS=30
# Midnight for guest link expiry is counted in this timezone (e.g. Asia/Jakarta); defaults to APP_TIMEZONE
GUEST_LINK_TIMEZONE=
# Days a deleted guest link's slug stays blocked (shows "Link Expired")
RETIRED_SLUG_DAYS=90

# HOP ID: the other HOP apps (PixelHop, NoteHop, …) sign in with accounts from here.
# They are rows in the `apps` table (php artisan hop:bootstrap imports the keys
# below once; after that these keys are only read by hop:bootstrap).
# Use the same random secret (32+ characters) as HELINK_SSO_SECRET in PixelHop
# and NOTEHOP_SSO_SECRET in NoteHop, a different one per app.
PIXELHOP_URL=
PIXELHOP_SSO_SECRET=
NOTEHOP_URL=
NOTEHOP_SSO_SECRET=
# Imperium (the HOP control center): registered as a hidden app with the admin_client
# capability, so it can read and act on accounts through the signed /api/hop/* API.
# Same secret as HOP_ID_SECRET in Imperium.
IMPERIUM_URL=
IMPERIUM_SSO_SECRET=
# Shown in buttons ("Login with HOP"). Leave as is.
HOP_BRAND=HOP
