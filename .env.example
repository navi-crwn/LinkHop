# LinkHop: a HOP app. Accounts (HOP ID) live at the hub; this app shares the hub's database.
# Application
APP_NAME="LinkHop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The dashboard and the API (link.hel.ink). Until cutover production still runs at https://hel.ink.
APP_URL=https://link.hel.ink
# Where short links (PUBLIC_URL/l/{slug}) and bio pages (PUBLIC_URL/b/{slug}) are reached by the public.
PUBLIC_URL=https://hel.ink
# Until this date hel.ink/{slug} answers with a 301 to hel.ink/l/{slug} and the dashboard shows the notice.
LEGACY_SLUG_UNTIL=2026-11-27
APP_TIMEZONE=UTC

# Link in bio (the hop/bio package). Off: no /bio or /b/ routes, no bio menu, no bio tables needed.
BIO_ENABLED=true

# HOP ID (the hub): sign-in, sign-out and API tokens come from here (hop/auth).
HOP_APP=linkhop
HOP_HUB_URL=https://hub.hel.ink
# The same 32+ character secret as HOP_SSO_SECRET (or HOP_SSO_SECRET_LINKHOP) at the hub. Also signs
# the hub's calls to /internal/accounts/* (export and purge of this app's data for an account).
HOP_SSO_SECRET=
# Previous secret during zero-downtime rotation (optional):
# HOP_SSO_SECRET_PREV=
# The other apps, for the app switcher (same values as the hub's .env).
LINKHOP_URL="${APP_URL}"
BIOHOP_URL=https://bio.hel.ink
BIOHOP_ENABLED=true
PIXELHOP_URL=https://p.hel.ink
PIXELHOP_ENABLED=true

# Owner fallback: this address counts as `owner` until the hub's roles table says otherwise.
SUPERADMIN_EMAIL=admin@yourdomain.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=helink
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Session
SESSION_DRIVER=database
# One cookie name per HOP app, so apps on *.hel.ink never share or overwrite a session.
SESSION_COOKIE=linkhop_session
SESSION_SECURE_COOKIE=true
# Minutes without activity before a signed-in session ends (the inactivity logout uses the same
# value). Shorter is safer on shared computers; longer means fewer "session expired" prompts.
# With "remember me" the user is signed back in silently, so this mostly limits idle tabs.
SESSION_LIFETIME=120
AUTH_REMEMBER_MINUTES=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache & Queue
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Redis (Optional - for better performance)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# GeoIP Service (for location tracking)
GEOIP_SERVICE=ipapi
IPAPI_KEY=your-ipapi-key

# Cloudflare Turnstile (Optional - CAPTCHA on the abuse report form)
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Sentry (Optional - Error tracking)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# AWS (Optional - for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
VITE_APP_NAME="${APP_NAME}"

# Proxies in front of the app (Cloudflare ranges, 127.0.0.1 for local nginx, or * if only reachable via proxy)
TRUSTED_PROXIES=cloudflare

# Abuse protection (optional)
SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
ABUSE_REGISTER_PER_HOUR=3
GUEST_LINK_IDLE_DAYS=14
GUEST_LINK_MAX_DAYS=30
# Midnight for guest link expiry is counted in this timezone (e.g. Asia/Jakarta); defaults to APP_TIMEZONE
GUEST_LINK_TIMEZONE=
# Days a deleted guest link's slug stays blocked (shows "Link Expired")
RETIRED_SLUG_DAYS=90

# App registry for the signed admin API (`apps` table, imported once by php artisan hop:bootstrap).
# Imperium (the HOP control center): registered as a hidden app with the admin_client
# capability, so it can read and act on accounts through the signed /api/hop/* API.
# Same secret as HOP_ID_SECRET in Imperium.
IMPERIUM_URL=
IMPERIUM_SSO_SECRET=
# Imperium's second door (Cloudflare Access hostname), its own secret (IMPERIUM_ALT_SECRET in Imperium).
CITADEL_URL=
CITADEL_SSO_SECRET=
# Where /admin sends admins and what the sidebar calls it (the built-in admin
# pages are gone; Imperium covers them through the admin API). Usually IMPERIUM_URL.
HOP_CONTROL_URL=
HOP_CONTROL_NAME="Control center"
HOP_BRAND=HOP
