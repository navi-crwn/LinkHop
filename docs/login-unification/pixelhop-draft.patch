--- /dev/null
+++ b/internal/app/helink_only_test.go
@@ -0,0 +1,58 @@
+package app
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+
+	"github.com/navi-crwn/pixelhop/internal/db"
+)
+
+func postForm(h http.Handler, path string, v url.Values) *httptest.ResponseRecorder {
+	req := httptest.NewRequest("POST", path, strings.NewReader(v.Encode()))
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	rec := httptest.NewRecorder()
+	h.ServeHTTP(rec, req)
+	return rec
+}
+
+func hasSession(rec *httptest.ResponseRecorder) bool {
+	for _, c := range rec.Result().Cookies() {
+		if c.Name == sessionCookie && c.Value != "" {
+			return true
+		}
+	}
+	return false
+}
+
+// With HEL.ink accounts on, HEL.ink is the only place to sign in or sign up.
+func TestHelinkIsTheOnlySignIn(t *testing.T) {
+	t.Setenv("GOOGLE_CLIENT_ID", "id")
+	t.Setenv("GOOGLE_CLIENT_SECRET", "key")
+	a, h := ssoApp(t)
+	for _, path := range []string{"/login", "/register"} {
+		body := fetch(h, path).Body.String()
+		if !strings.Contains(body, `href="/auth/helink?next=`) || !strings.Contains(body, `href="https://hel.example.com/join/pixelhop"`) {
+			t.Errorf("%s: no HEL.ink buttons", path)
+		}
+		if strings.Contains(body, `name="password"`) || strings.Contains(body, "/auth/google") {
+			t.Errorf("%s: still offers its own password or Google sign-in", path)
+		}
+	}
+	if body := fetch(h, "/").Body.String(); !strings.Contains(body, `<dialog id="helink-signin"`) || !strings.Contains(body, `data-open-dialog="#helink-signin"`) {
+		t.Error("guests get the HEL.ink sign-in popup from the menu")
+	}
+	// Old local passwords and sign-up forms no longer sign anyone in.
+	a.db.InsertUser(t.Context(), &db.User{Email: "old@example.com", PassHash: HashPassword("random123"), QuotaBytes: 1 << 20})
+	if rec := postForm(h, "/login", url.Values{"email": {"old@example.com"}, "password": {"random123"}}); hasSession(rec) {
+		t.Error("local password sign-in still works")
+	}
+	if rec := postForm(h, "/register", url.Values{"email": {"new@example.com"}, "password": {"random123"}}); hasSession(rec) {
+		t.Error("local sign-up still works")
+	}
+	if rec := fetch(h, "/auth/google"); rec.Code != http.StatusNotFound {
+		t.Errorf("own Google sign-in still on: %d", rec.Code)
+	}
+}
